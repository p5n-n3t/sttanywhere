#!/usr/bin/env python3
"""Run a shell or CLI in an opt-in managed tmux terminal for safe dictation."""
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from lib.terminal_bridge import start


if __name__ == '__main__':
    try:
        raise SystemExit(start(sys.argv[1:]))
    except Exception as exc:
        print(f'STT Anywhere terminal: {exc}', file=sys.stderr)
        raise SystemExit(1)
