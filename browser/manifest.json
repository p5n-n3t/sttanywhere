{
  "manifest_version": 3,
  "name": "STT Anywhere Companion",
  "version": "1.0.0",
  "description": "Safely place transcription results into the field where recording began.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }]
}
